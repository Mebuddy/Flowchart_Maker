# Google Gemini API key (Server-side only)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Optional model override (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Access password for single-owner protection
APP_ACCESS_PASSWORD=your_secure_access_password_here

# Session secret used to sign session cookies (at least 32 characters)
APP_SESSION_SECRET=your_random_32_char_secret_key_here
